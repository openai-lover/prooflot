# Default operation is entirely offline and free. This file is documentation.
# Set environment variables in your shell; never put an API key in the browser.
PORT=4317
AGENTPROOF_DATA_DIR=./data
# Live mode also requires operator approval and current, explicit prices.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
LIVE_APPROVED_DAILY_MICROS=0
LIVE_INPUT_MICROS_PER_MILLION=0
LIVE_OUTPUT_MICROS_PER_MILLION=0
LIVE_INPUT_TOKEN_BOUND=8192
LIVE_MAX_OUTPUT_TOKENS=256
LIVE_ALLOW_ESTIMATED_CAP=false
# Testnet setup writes public account metadata to data/testnet-public.json
# and encrypted development keys to data/testnet-keys.dpapi (Windows only).
